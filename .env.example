# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# DATABASE_URL is used at runtime (pooler is fine). DIRECT_URL is used by
# Prisma migrations and must be a direct connection.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baris_om?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/baris_om?schema=public"

# Integration tests (npm run test:integration) run ONLY when DATABASE_URL_TEST
# is set, and they migrate + seed that database. Never point it at dev/prod.
# DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/baris_om_test?schema=public"
# DIRECT_URL_TEST="postgresql://postgres:postgres@localhost:5432/baris_om_test?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Any long random string. Rotating it logs every user out.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="12h"

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Used in emails / links back to the app.
APP_URL="http://localhost:5173"

# ─── Artwork file storage ────────────────────────────────────────────────────
# STORAGE_DRIVER=local writes under STORAGE_DIR (default ./storage).
# STORAGE_DRIVER=supabase uploads to the SUPABASE_BUCKET bucket using the
# service-role key (never expose that key to the browser).
STORAGE_DRIVER=local
STORAGE_DIR=./storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=artworks
# Max upload size per artwork file, in megabytes.
MAX_UPLOAD_MB=50

# ─── MES integration ─────────────────────────────────────────────────────────
# Outbound: when an order is sent to MES the API POSTs the job to
# `${MES_BASE_URL}/jobs` with `Authorization: Bearer ${MES_OUTBOUND_TOKEN}`.
# Leave MES_BASE_URL blank to run in "manual" mode — the order still moves to
# In Printing and the job payload is logged, but nothing is called.
MES_BASE_URL=
MES_OUTBOUND_TOKEN=
# Inbound: MES calls POST /api/v1/mes/webhook with header `x-mes-api-key`.
# Generate a long random value and configure the same value on the MES side.
MES_WEBHOOK_KEY="change-me-mes-webhook-key"

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Set to 1 to bypass all request throttling (integration tests do this).
# Leave unset in every real environment.
# THROTTLE_DISABLED=1

# ─── Seed admin (only used by `npm run seed`) ────────────────────────────────
SEED_ADMIN_EMAIL="admin@barisiml.com.au"
SEED_ADMIN_PASSWORD="ChangeMe123!"
